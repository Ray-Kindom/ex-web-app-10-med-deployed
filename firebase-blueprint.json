{
  "$schema": "https://raw.githubusercontent.com/firebase/firebase-tools/master/schema/blueprint.json",
  "entities": {
    "User": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "uid": { "type": "string" },
        "username": { "type": "string" },
        "name": { "type": "string" },
        "rank": { "type": "string" },
        "role": { "type": "string", "enum": ["CO", "Offr", "RSM", "P BSM", "Q BSM", "R BSM", "HQ BSM", "Admin"] },
        "assignedBatteries": { "type": "array", "items": { "type": "string" } },
        "assignedBattery": { "type": "string" },
        "email": { "type": "string" },
        "lastLogin": { "type": "string" },
        "avatar": { "type": "string" }
      },
      "required": ["id", "username", "name", "role"]
    },
    "Personnel": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "rk": { "type": "string" },
        "trade": { "type": "string" },
        "snkNo": { "type": "string" },
        "name": { "type": "string" },
        "battery": { "type": "string", "enum": ["HQ Bty", "P Bty", "Q Bty", "R Bty"] },
        "status": { "type": "string" },
        "statusDetails": { "type": "string" },
        "medicalCat": { "type": "string" },
        "bloodGrp": { "type": "string" },
        "dob": { "type": "string" },
        "doe": { "type": "string" },
        "svcYears": { "type": "number" },
        "lveRemaining": { "type": "number" },
        "mobile": { "type": "string" },
        "emergencyContact": { "type": "string" },
        "address": { "type": "string" },
        "courses": { "type": "array", "items": { "type": "string" } },
        "lastFiring": { "type": "string" },
        "bpfc": { "type": "string" },
        "photo": { "type": "string" },
        "remarks": { "type": "string" },
        "outOfUnitCategory": { "type": "string" },
        "outOfUnitLocation": { "type": "string" },
        "outOfUnitStartDate": { "type": "string" },
        "outOfUnitEndDate": { "type": "string" },
        "outOfUnitAuthority": { "type": "string" },
        "outOfUnitRemarks": { "type": "string" }
      },
      "required": ["id", "rk", "trade", "snkNo", "name", "battery", "status"]
    },
    "SystemCategory": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "code": { "type": "string" },
        "order": { "type": "number" },
        "isActive": { "type": "boolean" },
        "type": { "type": "string" },
        "assignedParadeStates": { "type": "array", "items": { "type": "string" } },
        "applicableSubUnits": { "type": "array", "items": { "type": "string" } },
        "applicableRankCategories": { "type": "array", "items": { "type": "string" } },
        "subCategories": { "type": "array" }
      },
      "required": ["id", "name", "order", "isActive", "subCategories"]
    },
    "SubUnitConfig": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string" },
        "name": { "type": "string" },
        "order": { "type": "number" },
        "isActive": { "type": "boolean" },
        "commanderTitle": { "type": "string" }
      },
      "required": ["id", "code", "name", "order", "isActive"]
    },
    "RankConfig": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "code": { "type": "string" },
        "category": { "type": "string" },
        "order": { "type": "number" },
        "seniority": { "type": "number" },
        "isActive": { "type": "boolean" },
        "applicableForEnlistment": { "type": "boolean" },
        "banglaName": { "type": "string" }
      },
      "required": ["id", "name", "category", "order", "isActive"]
    },
    "TradeConfig": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "code": { "type": "string" },
        "category": { "type": "string" },
        "order": { "type": "number" },
        "isActive": { "type": "boolean" },
        "applicableRankCategories": { "type": "array", "items": { "type": "string" } },
        "applicableForEnlistment": { "type": "boolean" },
        "banglaName": { "type": "string" },
        "description": { "type": "string" }
      },
      "required": ["id", "name", "code", "order", "isActive"]
    },
    "AuthEstablishmentItem": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "category": { "type": "string" },
        "authorized": { "type": "number" },
        "hqBty": { "type": "number" },
        "pBty": { "type": "number" },
        "qBty": { "type": "number" },
        "rBty": { "type": "number" },
        "wksp": { "type": "number" },
        "notes": { "type": "string" }
      },
      "required": ["id", "category", "authorized"]
    },
    "CalculationConfig": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "totalOutCategories": { "type": "array", "items": { "type": "string" } },
        "offParadeCategories": { "type": "array", "items": { "type": "string" } },
        "onParadeFormula": { "type": "string" },
        "autoCalculateOffParade": { "type": "boolean" },
        "autoCalculateOnParade": { "type": "boolean" },
        "strictDiscrepancyCheck": { "type": "boolean" }
      },
      "required": ["id", "totalOutCategories", "offParadeCategories"]
    },
    "DailyParadePoint": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "order": { "type": "number" },
        "isActive": { "type": "boolean" },
        "enabledBatteries": { "type": "array", "items": { "type": "string" } },
        "counts": { "type": "object" },
        "rsmSuggested": { "type": "object" }
      },
      "required": ["id", "name", "order", "isActive", "counts"]
    },
    "DutyAssignment": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string" },
        "dutyType": { "type": "string" },
        "assignedPersonnel": { "type": "array" },
        "status": { "type": "string" },
        "shift": { "type": "string" },
        "remarks": { "type": "string" },
        "location": { "type": "string" }
      },
      "required": ["id", "date", "dutyType", "assignedPersonnel", "status"]
    },
    "AuditLogItem": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "timestamp": { "type": "string" },
        "action": { "type": "string" },
        "performedBy": { "type": "string" },
        "role": { "type": "string" },
        "details": { "type": "string" },
        "category": { "type": "string", "enum": ["SECURITY", "PERSONNEL", "PARADE_STATE", "SYSTEM"] }
      },
      "required": ["id", "timestamp", "action", "performedBy", "details", "category"]
    },
    "RegimentSettings": {
      "type": "object",
      "properties": {
        "customLogo": { "type": "string" },
        "unitName": { "type": "string" },
        "motto": { "type": "string" }
      }
    },
    "ParadeType": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "order": { "type": "number" },
        "createdBy": { "type": "string" },
        "headings": { "type": "array", "items": { "type": "string" } },
        "isDeleted": { "type": "boolean" }
      },
      "required": ["id", "name", "order"]
    },
    "ParadeRecord": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string" },
        "typeId": { "type": "string" },
        "battery": { "type": "string" },
        "status": { "type": "string" },
        "strengthSummary": { "type": "object" },
        "confirmedBy": { "type": "string" },
        "confirmedAt": { "type": "string" }
      },
      "required": ["id", "date", "typeId", "battery", "status"]
    },
    "ParadeDutyAssignment": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string" },
        "sessionType": { "type": "string" },
        "assignments": { "type": "array" }
      },
      "required": ["date", "sessionType", "assignments"]
    },
    "AccessRequest": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "name": { "type": "string" },
        "photoURL": { "type": "string" },
        "requestedAt": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "assignedRole": { "type": "string" },
        "assignedRank": { "type": "string" },
        "assignedBattery": { "type": "string" }
      },
      "required": ["id", "email", "name", "requestedAt", "status"]
    }
  },
  "firestore": {
    "/access_requests/{requestId}": {
      "schema": "AccessRequest",
      "description": "Google sign-in access requests waiting for Owner approval"
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "Registered system user accounts and roles"
    },
    "/system_categories/{catId}": {
      "schema": "SystemCategory",
      "description": "Dynamic database-driven category and sub-category hierarchy managed by Admin"
    },
    "/sub_units/{unitId}": {
      "schema": "SubUnitConfig",
      "description": "Sub-unit definitions, batteries, and workshop detachments managed by Admin"
    },
    "/military_ranks/{rankId}": {
      "schema": "RankConfig",
      "description": "Military rank structure, seniority, and personnel rank categories managed by Admin"
    },
    "/military_trades/{tradeId}": {
      "schema": "TradeConfig",
      "description": "Military trades, gunner specializations, and trades classifications managed dynamically by Admin"
    },
    "/auth_establishment/{estId}": {
      "schema": "AuthEstablishmentItem",
      "description": "Authorized unit war/peace establishment numbers managed strictly by Admin"
    },
    "/calculation_config/{cfgId}": {
      "schema": "CalculationConfig",
      "description": "Configurable calculation rules for Total Out, Off Parade, and On Parade"
    },
    "/parade_types/{typeId}": {
      "schema": "ParadeType",
      "description": "Parade states, schedules, and custom periods"
    },
    "/parade_records/{recordId}": {
      "schema": "ParadeRecord",
      "description": "Daily roll call and battery parade state records"
    },
    "/personnel/{personnelId}": {
      "schema": "Personnel",
      "description": "Regiment soldier master records with strength and parade status"
    },
    "/parade_points/{pointId}": {
      "schema": "DailyParadePoint",
      "description": "Daily parade line points and battery strength counts"
    },
    "/parade_duty_assignments/{assignmentId}": {
      "schema": "ParadeDutyAssignment",
      "description": "Daily parade duty assignments by category and session"
    },
    "/duty_roster/{dutyId}": {
      "schema": "DutyAssignment",
      "description": "Operational duties, guards, and roster assignments"
    },
    "/audit_logs/{logId}": {
      "schema": "AuditLogItem",
      "description": "Immutable security and operational compliance audit trail"
    },
    "/settings/{settingId}": {
      "schema": "RegimentSettings",
      "description": "Unit heraldic emblem and global regiment parameters"
    }
  }
}
