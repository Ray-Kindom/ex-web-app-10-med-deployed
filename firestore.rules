rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Operational Collections for 10 Medium Regiment Artillery App
    // 1. /users/{userId} - User accounts and roles
    match /users/{userId} {
      allow read, write: if true;
    }

    // 2. /system_categories/{catId} - Dynamic Categories & Sub-categories
    match /system_categories/{catId} {
      allow read, write: if true;
    }

    // 3. /sub_units/{unitId} - Sub-units / Batteries
    match /sub_units/{unitId} {
      allow read, write: if true;
    }

    // 4. /military_ranks/{rankId} - Military Ranks
    match /military_ranks/{rankId} {
      allow read, write: if true;
    }

    // 4b. /military_trades/{tradeId} - Military Trades & Specializations
    match /military_trades/{tradeId} {
      allow read, write: if true;
    }

    // 5. /auth_establishment/{estId} - Auth Establishment
    match /auth_establishment/{estId} {
      allow read, write: if true;
    }

    // 6. /calculation_config/{cfgId} - Calculation Rules Config
    match /calculation_config/{cfgId} {
      allow read, write: if true;
    }

    // 7. /parade_types/{typeId} - Parade States (Admin & RSM managed)
    match /parade_types/{typeId} {
      allow read, write: if true;
    }

    // 8. /parade_records/{recordId} - Daily Roll Call & Parade State Records
    match /parade_records/{recordId} {
      allow read, write: if true;
    }

    // 9. /personnel/{personnelId} - Nominal Roll & Personnel Records
    match /personnel/{personnelId} {
      allow read, write: if true;
    }

    // 10. /parade_points/{pointId} - Daily Parade Points & Counts
    match /parade_points/{pointId} {
      allow read, write: if true;
    }

    // 11. /duty_roster/{dutyId} - Duty Roster Assignments
    match /duty_roster/{dutyId} {
      allow read, write: if true;
    }

    // 12. /audit_logs/{logId} - Security Audit Trail
    match /audit_logs/{logId} {
      allow read, write: if true;
    }

    // 13. /settings/{settingId} - Regiment Settings and Battery Statuses
    match /settings/{settingId} {
      allow read, write: if true;
    }

    // 14. /test/{testId} - Connectivity Healthcheck
    match /test/{testId} {
      allow read, write: if true;
    }

    // 15. /parade_duty_assignments/{assignmentId} - Daily Parade Duty Assignments & Details
    match /parade_duty_assignments/{assignmentId} {
      allow read, write: if true;
    }

    // 16. /access_requests/{requestId} - Google Login Owner Approval Requests
    match /access_requests/{requestId} {
      allow read, write: if true;
    }

    // Catch-all for any other regiment data collections
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
